# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/movie_memory"

# Auth.js: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI
OPENAI_API_KEY=""
# Optional, defaults to gpt-4o-mini
OPENAI_MODEL=""
